{
  "name": "adminsimpl",
  "version": "0.1.0",
  "private": true,
  "description": "Assistant d'automatisation des démarches administratives",
  "author": "AdminSimpl",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "electron-builder install-app-deps",
    "icon": "node scripts/build-icon.cjs",
    "electron:prepare": "next build && node scripts/prepare-electron.cjs",
    "electron:dev": "concurrently -k -n next,electron -c blue,magenta \"npm:dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build:win": "npm run electron:prepare && electron-builder --win --x64",
    "electron:build:linux": "npm run electron:prepare && electron-builder --linux --x64"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "png-to-ico": "^3.0.1",
    "postcss": "8.4.39",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.adminsimpl.app",
    "productName": "AdminSimpl",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AdminSimpl",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
